# Environment variables read by the backend (app/config.py). Nothing here is secret.
# The app reads real environment variables; it does not load this file by itself.
#   PowerShell:      $env:MODEL_MODE = "replay"
#   Command Prompt:  set MODEL_MODE=replay

# dev | prod. In prod, CORS is never open by default.
APP_ENV=dev

# SQLite file, stored images and heatmaps.
DATA_DIR=./data
# Default: a SQLite file inside DATA_DIR.
# DATABASE_URL=sqlite:///./data/voxelsort.db
MODEL_ARTIFACTS_DIR=./model_artifacts

# Comma-separated browser origins. Unset in dev = any origin. Always set it in prod.
ALLOWED_ORIGINS=http://localhost:5173
# Optional regular expression for extra origins, for example the preview URLs of ONE Vercel project:
# ALLOWED_ORIGIN_REGEX=https://voxelsort-[a-z0-9-]+\.vercel\.app

MAX_UPLOAD_MB=15
# Anti-starvation wait cap. Changeable at run time through PUT /queue/settings (10 to 1440).
DEFAULT_MAX_WAIT_MINUTES=120
# Floor for threshold changes, checked on the NIH validation split.
MIN_SENSITIVITY_TARGET=0.9
# Width of the "AI unsure" band. Default: Member A's policy.json (0.10).
# UNSURE_BUDGET=0.10

# auto   = real model if its files are installed and verified, else replay of saved outputs, else none
# real   = require the real model (GET /health reports degraded if it cannot load)
# replay = never run the model; saved outputs for byte-identical demo images only
# fake   = DEVELOPMENT ONLY: made-up numbers, labelled FAKE everywhere
# none   = no model output
MODEL_MODE=auto

# 0 starts with an empty queue.
SEED_DEMO=1
ONNX_THREADS=1
LOG_LEVEL=INFO
